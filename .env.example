# Copy this file to .env and fill in real values. Never commit .env.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/zhuoyue
CLIENT_ORIGIN=http://localhost:3100
JWT_ACCESS_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
NODE_ENV=development
